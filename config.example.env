# Quantive Terminal Client Configuration
# Copy this file to .env and fill in your details

# === Quantive Connection ===
QUANTIVE_API_BASE=https://dash.quantive.my.id
QUANTIVE_API_KEY=qt_xxxxxxxxxxxxxxxxxxxxxxxx

# === Exchange ===
EXCHANGE=binance              # binance | bybit | lighter
EXCHANGE_API_KEY=your_binance_api_key
EXCHANGE_API_SECRET=your_binance_api_secret
EXCHANGE_TESTNET=false

# === Risk Management ===
RISK_PCT_PER_TRADE=1.0        # % of equity risked per trade
MAX_OPEN_POSITIONS=2          # max concurrent positions
MAX_SLIPPAGE_PCT=0.3          # skip signal if price moved >0.3% from ref
ALLOW_SHORT=false

# === Subscriptions ===
# Comma-separated version codes from https://dash.quantive.my.id/guide
QUANTIVE_SUBSCRIPTIONS=BTC_1H_ML_V1
# Per-version risk overrides (JSON): {"BTC_1H_ML_V1":{"risk_pct":1.0},"BTC_1H_ML_V3":{"risk_pct":0.5}}
QUANTIVE_RISK_CONFIG={}

# === Telegram (Optional) ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === Advanced ===
POLL_INTERVAL_SEC=2           # signal polling interval
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
ORPHAN_ACTION=close           # close | track — what to do with orphan positions on restart
